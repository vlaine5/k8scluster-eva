# =============================================================================
#  Profil « pratiques d'entreprise » sur Proxmox : 3 control-planes, Cilium
#  sans kube-proxy (Gateway API et LoadBalancer L2 par Cilium, Hubble),
#  Longhorn sur disques dédiés, GitOps, supervision, journaux, politiques
#  Kyverno (audit), scan de vulnérabilités, secrets externes, sauvegardes.
#    LAB_ENV_FILE=examples/profiles/enterprise-lab.env make deploy
#  Copiez examples/homelab/terraform.tfvars.example vers
#  terraform/providers/proxmox/terraform.tfvars et adaptez-le. Prévoir ~48 Go de RAM.
#  Adresses et réseaux : EXEMPLES À VALIDER dans votre IPAM avant tout déploiement.
# =============================================================================
DEPLOYMENT_MODE=terraform
DEPLOYMENT_PROVIDER=proxmox
CLUSTER_NAME=entreprise
CONTROL_PLANE_COUNT=3
WORKER_COUNT=3
NODE_CPUS=4
NODE_MEMORY_MB=8192
NODE_DISK_GB=40
NODE_OS=rocky
NODE_OS_VERSION=9
NODE_NETWORK_CIDR=10.20.0.0/16
CONTROL_PLANE_VIP=10.20.0.99
SERVICE_CIDR=10.250.0.0/16
CNI=cilium
ENABLE_HUBBLE=true
HUBBLE_UI=true
ADDON_PROFILE=enterprise-lab
GATEWAY_CONTROLLER=cilium
LOADBALANCER_PROVIDER=cilium-l2
LOADBALANCER_IP_POOL=10.20.0.200-10.20.0.210
GATEWAY_DOMAIN=entreprise.lab.internal
STORAGE_BACKENDS=longhorn
LONGHORN_DEDICATED_DISK=true
LONGHORN_DISK_SIZE_GB=50
MONITORING_PERSISTENCE=true
LOGGING_PERSISTENCE=true
KYVERNO_POLICY_MODE=audit
BACKUP_ENABLED=true
BACKUP_PROVIDER=etcd-snapshot
