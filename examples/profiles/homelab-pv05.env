# =============================================================================
#  Homelab Proxmox VE « pv05 » (Dell T610, Xeon X5690 : x86-64-v2 uniquement).
#  1 control-plane + 3 workers (4 vCPU, 4 Gio, 300 Gio), Debian 13, Cilium,
#  Traefik (Gateway API), MetalLB, cert-manager (CA interne), metrics-server,
#  Argo CD, NFS CSI (NAS Synology) et Longhorn (disque dédié par worker).
#
#  Procédure complète (à suivre à la main, après revue) : docs/homelab-pv05.md
#    cp examples/profiles/homelab-pv05.env .env        puis ajoutez les secrets Proxmox
#    cp examples/homelab/terraform.tfvars.example terraform/providers/proxmox/terraform.tfvars
#    make doctor ; make config ; make validate          (lecture seule)
#    make plan MODE=terraform PROVIDER=proxmox          (plan SANS création de VM)
#    make deploy MODE=terraform PROVIDER=proxmox        (après revue du plan Terraform)
#
#  Les valeurs marquées « À VALIDER » sont des PROPOSITIONS : vérifiez-les dans
#  votre IPAM, sur le NAS et sur le pare-feu avant le premier déploiement.
#  Le NAS et le pare-feu Stormshield ne sont JAMAIS modifiés par le framework.
# =============================================================================
DEPLOYMENT_MODE=terraform
DEPLOYMENT_PROVIDER=proxmox
CLUSTER_NAME=homelab

# --- Nœuds -------------------------------------------------------------------
CONTROL_PLANE_COUNT=1
WORKER_COUNT=3
NODE_CPUS=4
NODE_MEMORY_MB=4096
NODE_DISK_GB=300
NODE_OS=debian
NODE_OS_VERSION=13
# CPU « host » = performances natives, sans migration à chaud garantie entre hôtes différents.
# Le Dell T610 Westmere ne prend pas en charge AVX2.
NODE_CPU_TYPE=host

# --- Réseau (VLAN 20 : vmbr0 est déjà sur ce VLAN, aucun tag VLAN ajouté) ----
# Nœuds : 10.20.50.10/16 (control-plane), .11-.13/16 (workers) : terraform.tfvars.
# Le préfixe 10.20.50 ne crée PAS un sous-réseau /24.
NODE_NETWORK_CIDR=10.20.0.0/16
# Passerelle et hyperviseur. À VALIDER : ajoutez la plage DHCP du VLAN 20.
RESERVED_IPS=10.20.0.1,10.20.0.30,10.20.0.31
# Réseaux déjà utilisés dans le homelab (NAS, autres VLAN). À VALIDER.
RESERVED_CIDRS=10.70.0.0/16,10.101.0.0/16,10.102.0.0/16,10.103.0.0/16,10.104.0.0/16,10.105.0.0/16
POD_CIDR=10.244.0.0/16
# Le défaut 10.96.0.0/12 (10.96 à 10.111) chevaucherait 10.101-105.0.0/16.
SERVICE_CIDR=10.250.0.0/16
CNI=cilium
# VXLAN : les Pods communiquent via le réseau des nœuds, sans route inter-VLAN ajoutée.
CNI_MODE=vxlan

# --- Addons ------------------------------------------------------------------
ADDON_PROFILE=homelab
GATEWAY_CONTROLLER=traefik
GATEWAY_DOMAIN=k8s.homelab.internal
CERT_MANAGER_ISSUER=selfsigned-ca
LOADBALANCER_PROVIDER=metallb
LOADBALANCER_MODE=l2
# À VALIDER : hors DHCP, hors IP fixes, réservée dans l'IPAM.
LOADBALANCER_IP_POOL=10.20.80.100-10.20.80.200

# --- Stockage ----------------------------------------------------------------
STORAGE_BACKENDS=nfs-csi,longhorn
DEFAULT_STORAGE_CLASS=longhorn
# NAS Synology (VLAN 20) : adresse/partage à confirmer avant tout déploiement.
# Autoriser les nœuds 10.20.50.10-13 à accéder à l'export NFSv4.1 (TCP 2049).
NFS_SERVER=10.20.0.30
NFS_SHARE=/volume1/kubevolume
NFS_VERSION=4.1
NFS_RECLAIM_POLICY=Retain
# Un disque virtuel NEUF de 100 Gio par worker (scsi1, créé par Terraform, formaté
# uniquement s'il est vide et porte le numéro de série du lab).
LONGHORN_DEDICATED_DISK=true
LONGHORN_DISK_SIZE_GB=100
LONGHORN_REPLICA_COUNT=3
LONGHORN_RECLAIM_POLICY=Retain

# --- Exploitation ------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_PROVIDER=etcd-snapshot

# --- Secrets : UNIQUEMENT dans .env (jamais versionné) -------------------------
# PROXMOX_VE_ENDPOINT=https://10.20.0.31:8006/
# PROXMOX_VE_API_TOKEN=terraform@pve!k8s-lab=<secret>
# PROXMOX_VE_INSECURE=true        # seulement si le certificat de Proxmox est auto-signé
