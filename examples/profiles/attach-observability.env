# =============================================================================
#  Mode attach : ajoute des addons à un cluster Kubernetes EXISTANT (k3s, RKE2,
#  kubeadm installé par un autre outil, cluster managé...). Ni les nœuds, ni la
#  version, ni le CNI ne sont modifiés ; un composant déjà installé par un autre
#  outil n'est jamais repris (EXISTING_ADDON_POLICY=fail).
#    LAB_ENV_FILE=examples/profiles/attach-observability.env make doctor
#    LAB_ENV_FILE=examples/profiles/attach-observability.env make addons-plan
#    LAB_ENV_FILE=examples/profiles/attach-observability.env make deploy
#  Guide : docs/attach-mode.md
# =============================================================================
DEPLOYMENT_MODE=attach
EXISTING_KUBECONFIG=~/.kube/config
EXISTING_CONTEXT=mon-cluster
CLUSTER_NAME=mon-cluster
ADDON_PROFILE=observability
EXISTING_ADDON_POLICY=fail
