# =============================================================================
#  Profil « découverte » : kind sur votre poste, sans addon optionnel.
#    LAB_ENV_FILE=examples/profiles/kind-minimal.env make deploy
#  Prérequis : Docker, kind, kubectl (make doctor MODE=kind). ~2 Go de RAM.
# =============================================================================
DEPLOYMENT_MODE=kind
CLUSTER_NAME=decouverte
WORKER_COUNT=2
ADDON_PROFILE=minimal
