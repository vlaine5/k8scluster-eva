# =============================================================================
#  Mode existing : Kubernetes installé par kubeadm sur des machines Linux DÉJÀ
#  installées (bare metal, VMs créées à la main). Aucune machine n'est créée
#  ni supprimée ; un contrôle préalable en lecture seule précède toute action.
#    cp ansible/inventories/existing.example.ini ansible/inventories/maison.ini   (à adapter)
#    LAB_ENV_FILE=examples/profiles/existing-baremetal.env make doctor
#    LAB_ENV_FILE=examples/profiles/existing-baremetal.env make deploy
#  Guide : docs/existing-mode.md
# =============================================================================
DEPLOYMENT_MODE=existing
EXISTING_INVENTORY=ansible/inventories/maison.ini
CLUSTER_NAME=maison
# auto : la distribution de chaque machine est détectée (Ubuntu, Debian, Rocky).
NODE_OS=auto
CNI=flannel
ADDON_PROFILE=homelab
ADDONS=-argo-cd
GATEWAY_CONTROLLER=traefik
# Disques Longhorn : jamais devinés. Indiquez le périphérique (identique sur chaque
# worker, ou par machine dans l'inventaire : longhorn_disk_device=...).
# STORAGE_BACKENDS=longhorn
# LONGHORN_DEDICATED_DISK=true
# LONGHORN_DISK_DEVICE=/dev/disk/by-id/ata-EXEMPLE
