# =============================================================================
#  Profil « observabilité » sur kind : métriques, tableaux de bord, alertes,
#  journaux et traces, accessibles par la Gateway (Traefik) sur votre poste.
#    LAB_ENV_FILE=examples/profiles/kind-observability.env make deploy
#  Prévoir 8 Go de RAM libres pour Docker. Données NON persistantes (jetables).
# =============================================================================
DEPLOYMENT_MODE=kind
CLUSTER_NAME=observabilite
WORKER_COUNT=2
ADDON_PROFILE=observability
ADDONS=tempo,opentelemetry-collector,cert-manager
GATEWAY_CONTROLLER=traefik
GATEWAY_DOMAIN=lab.localhost
GRAFANA_EXPOSE=true
MONITORING_RETENTION=2d
LOGGING_RETENTION=48h
