# =============================================================================
#  Profil « haute disponibilité » sur VMs locales (Vagrant + libvirt/KVM) :
#  3 control-planes (etcd empilé, VIP kube-vip), 2 workers, Calico,
#  Envoy Gateway, MetalLB et cert-manager.
#    LAB_ENV_FILE=examples/profiles/vagrant-ha.env make deploy
#  Prévoir ~14 Go de RAM (5 VMs de 2 à 4 Go). Réseau privé 192.168.56.0/24.
# =============================================================================
DEPLOYMENT_MODE=vagrant
VAGRANT_PROVIDER=libvirt
CLUSTER_NAME=lab-ha
CONTROL_PLANE_COUNT=3
WORKER_COUNT=2
NODE_CPUS=2
NODE_MEMORY_MB=3072
NODE_OS=debian
NODE_OS_VERSION=12
# .10-.12 = control-planes, .13-.14 = workers ; VIP de l'API et pool LoadBalancer hors de ces adresses.
CONTROL_PLANE_VIP=192.168.56.9
CNI=calico
NETWORK_POLICY_MODE=calico
ADDON_PROFILE=homelab
ADDONS=-argo-cd
GATEWAY_CONTROLLER=envoy-gateway
LOADBALANCER_PROVIDER=metallb
LOADBALANCER_IP_POOL=192.168.56.200-192.168.56.220
GATEWAY_DOMAIN=lab-ha.internal
