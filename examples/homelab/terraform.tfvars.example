# =============================================================================
#  terraform/providers/proxmox/terraform.tfvars pour le homelab « pv05 ».
#    cp examples/homelab/terraform.tfvars.example terraform/providers/proxmox/terraform.tfvars
#  Aucun secret ici (token API : .env). Tailles, nombre de nœuds, OS : .env.
#  Procédure : docs/homelab-pv05.md
# =============================================================================

proxmox_node    = "pv05"
vm_datastore    = "local-lvm"
# Type de contenu « Import » activé sur ce stockage (image cloud téléchargée par Proxmox).
image_datastore = "local"
# Disques Longhorn dédiés (scsi1) : même stockage que les VMs.
longhorn_datastore = "local-lvm"

# vmbr0 est déjà sur le VLAN 20 : surtout PAS de vlan_id.
network_bridge = "vmbr0"

# 10.20.0.100 = k8s-cp-1, 10.20.0.101-103 = k8s-worker-1..3.
network_cidr = "10.20.0.0/16"
ip_start     = 100
gateway      = "10.20.0.1"
# À VALIDER : serveur(s) DNS du VLAN 20.
dns_servers  = ["10.20.0.1"]

# Facultatif : IDs de VMs fixes (control-plane puis workers) pour les retrouver facilement.
# vm_id_start = 2100
