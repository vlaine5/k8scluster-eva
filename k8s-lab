#!/usr/bin/env bash
# =============================================================================
#  k8s-lab — créer un cluster Kubernetes de plusieurs façons, pour apprendre.
#
#    ./k8s-lab                       menu interactif (débutants)
#    ./k8s-lab help                  toutes les commandes
#
#  Le code est volontairement simple : chaque commande affiche les vraies
#  commandes exécutées (kind, vagrant, terraform, ansible-playbook, kubectl).
# =============================================================================
set -Eeuo pipefail

LAB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
export LAB_ROOT

# shellcheck source=scripts/lib/common.sh
source "${LAB_ROOT}/scripts/lib/common.sh"
# shellcheck source=scripts/lib/resolver.sh
source "${LAB_ROOT}/scripts/lib/resolver.sh"
# shellcheck source=scripts/lib/doctor.sh
source "${LAB_ROOT}/scripts/lib/doctor.sh"
# shellcheck source=scripts/lib/kubeconfig.sh
source "${LAB_ROOT}/scripts/lib/kubeconfig.sh"
# shellcheck source=scripts/lib/smoke.sh
source "${LAB_ROOT}/scripts/lib/smoke.sh"
# shellcheck source=scripts/lib/ansible.sh
source "${LAB_ROOT}/scripts/lib/ansible.sh"
# shellcheck source=scripts/lib/mode_kind.sh
source "${LAB_ROOT}/scripts/lib/mode_kind.sh"
# shellcheck source=scripts/lib/mode_minikube.sh
source "${LAB_ROOT}/scripts/lib/mode_minikube.sh"
# shellcheck source=scripts/lib/mode_vagrant.sh
source "${LAB_ROOT}/scripts/lib/mode_vagrant.sh"
# shellcheck source=scripts/lib/mode_terraform.sh
source "${LAB_ROOT}/scripts/lib/mode_terraform.sh"
# shellcheck source=scripts/lib/eks.sh
source "${LAB_ROOT}/scripts/lib/eks.sh"
# shellcheck source=scripts/lib/mode_existing.sh
source "${LAB_ROOT}/scripts/lib/mode_existing.sh"
# shellcheck source=scripts/lib/mode_attach.sh
source "${LAB_ROOT}/scripts/lib/mode_attach.sh"
# shellcheck source=scripts/lib/addons.sh
source "${LAB_ROOT}/scripts/lib/addons.sh"
# shellcheck source=scripts/lib/day2.sh
source "${LAB_ROOT}/scripts/lib/day2.sh"

trap 'error "Commande interrompue (ligne ${LINENO}). Relancez avec DEBUG=1 pour plus de détails."' ERR
[[ "${DEBUG:-0}" == "1" ]] && set -x

usage() {
  cat <<HELP
${C_BOLD}k8s-lab${C_RESET} — clusters Kubernetes reproductibles, du laptop au homelab.

${C_BOLD}Cycle de vie${C_RESET}
  doctor   [mode]       vérifier les prérequis (et la configuration) pour un mode
  config   [mode]       configuration effective, plan résolu, avertissements (secrets masqués)
  validate [mode]       valider .env sans rien modifier
  deploy   <mode>       créer / compléter le cluster puis installer les addons (idempotent)
  status                voir les clusters du lab
  test                  test applicatif sur le cluster actif (nginx + Service + DNS)
  kubeconfig [mode]     configurer kubectl (fichier .kube/config)
  destroy  <mode>       supprimer le cluster (confirmation ; jamais en modes existing/attach)
  uninstall existing    retirer Kubernetes de machines existantes (machines conservées)

${C_BOLD}Addons${C_RESET} (catalogue : docs/addons.md)
  addons-plan [mode]    plan résolu (profil, dépendances, ordre, versions)
  addons-apply [mode]   installer / synchroniser        addons-status [mode]   état et santé
  addons-test [mode]    tests fonctionnels               addons-upgrade [mode]  nouvelles versions verrouillées
  addons-remove [mode] --addon NOM  désinstaller (données conservées)    addons-catalog   liste

${C_BOLD}Exploitation des clusters kubeadm${C_RESET}
  upgrade-plan [mode]   plan de mise à niveau (lecture seule)   upgrade [mode]     l'exécuter
  os-update [mode]      mises à jour de l'OS, nœud par nœud      health [mode]      santé
  backup [mode]         instantané etcd   restore [mode] SNAPSHOT=...   node-remove [mode] NODE=...
  storage-failure-test [mode] NODE=...   test DESTRUCTIF : perte d'un worker (Longhorn)
  versions              versions verrouillées      versions-check   nouvelles versions (sans rien installer)
  manifest [mode]       manifeste du déploiement (versions, options ; sans secret)

${C_BOLD}Modes${C_RESET}
  local :              kind  |  minikube
  kubeadm sur VMs :    vagrant  |  terraform proxmox  |  terraform vsphere  |  terraform libvirt
  machines existantes: existing   (inventaire Ansible : EXISTING_INVENTORY)
  cluster existant :   attach     (addons seulement : EXISTING_KUBECONFIG + EXISTING_CONTEXT)
  cloud managé :       terraform eks  (AWS, payant)
  Sans mode : DEPLOYMENT_MODE (et DEPLOYMENT_PROVIDER) de .env.

${C_BOLD}Options${C_RESET}
  --yes                 ne poser aucune question (les opérations critiques exigent *_CONFIRM=<nom>)
  --recreate            deploy : supprimer puis recréer le cluster (confirmation demandée)
  --keep                test / addons-test : conserver les ressources de test
  --addon NOM[,NOM]     addons-* : limiter l'action à ces addons
  --destructive         addons-test : inclure les tests destructifs (perte d'un réplica...)

Avec make : make deploy MODE=kind  |  make deploy MODE=terraform PROVIDER=proxmox  |  make addons-apply MODE=attach
Fichier de configuration : .env (modèle : .env.example), autre fichier : LAB_ENV_FILE=chemin
Guides : docs/README.md
HELP
}

# Lance doctor pour un mode et arrête tout si un prérequis manque.
require_doctor() {
  step "Vérification des prérequis (${1}${2:+ ${2}})"
  if [[ "${K8S_LAB_SKIP_DOCTOR:-0}" == "1" ]]; then
    warn "K8S_LAB_SKIP_DOCTOR=1 : vérification des prérequis ignorée (usage avancé)."
    return 0
  fi
  if ! doctor_mode "$@"; then
    die "${DOCTOR_ERRORS} prérequis manquant(s) pour le mode ${1}${2:+ ${2}} (détails ci-dessus)." \
      "Corrigez-les puis relancez : $(hint_cmd doctor "$1" "${2:-}")"
  fi
}

status_line() {
  local state="$1" name="$2" text="$3" color="${C_DIM}" symbol="○"
  case "${state}" in
    up) color="${C_GREEN}" symbol="●" ;;
    stopped) color="${C_YELLOW}" symbol="●" ;;
  esac
  printf '  %s%s%s %-12s %s\n' "${color}" "${symbol}" "${C_RESET}" "${name}" "${text}"
}

cmd_status() {
  step "Clusters du lab \"${CLUSTER_NAME}\""
  kind_status
  minikube_status
  vagrant_status
  terraform_status
  existing_status
  attach_status

  step "kubectl (.kube/config)"
  export KUBECONFIG="${LAB_KUBECONFIG}"
  if ! have kubectl; then
    warn "kubectl est introuvable : installez-le pour utiliser vos clusters (scripts/install-tools.sh kubectl)."
  elif [[ -s "${LAB_KUBECONFIG}" ]] && kubectl config get-contexts -o name 2>/dev/null | grep -q .; then
    run kubectl config get-contexts || true
    if kubectl config current-context >/dev/null 2>&1; then
      run kubectl get nodes -o wide --request-timeout=5s ||
        warn "Le cluster actif ne répond pas (arrêté ou détruit ?)."
    fi
    kubeconfig_hint "$(kubectl config current-context 2>/dev/null || echo '<contexte>')"
  else
    info "Aucun cluster dans .kube/config pour l'instant. Commencez par : $(hint_cmd deploy kind)"
  fi
}

# select_mode [mode] [provider] : mode demandé, sinon DEPLOYMENT_MODE/DEPLOYMENT_PROVIDER de .env.
select_mode() {
  local mode="${1:-}" provider="${2:-}"
  if [[ -z "${mode}" ]]; then
    mode="${DEPLOYMENT_MODE:-}"
    [[ "${mode}" != terraform ]] || provider="${DEPLOYMENT_PROVIDER:-}"
  fi
  case "${mode}" in
    kind | minikube | vagrant | existing | attach)
      [[ -z "${provider}" ]] || die "Le mode ${mode} ne prend pas de provider (reçu : ${provider})."
      ;;
    terraform | tf)
      mode=terraform
      tf_check_provider "${provider}"
      ;;
    "")
      die "Précisez le mode." "Exemples : $(hint_cmd deploy kind)   |   $(hint_cmd deploy terraform proxmox)" \
        "Ou DEPLOYMENT_MODE=... dans .env. Liste des modes : $(hint_cmd help)"
      ;;
    *)
      die "Mode inconnu : \"${mode}\"." "Modes : kind, minikube, vagrant, terraform <proxmox|vsphere|libvirt|eks>, existing, attach"
      ;;
  esac
  # Mémorisés pour les conseils affichés en cas d'erreur.
  LAB_MODE="${mode}"
  LAB_PROVIDER="${provider}"
}

cmd_config() {
  if [[ "${1:-}" == kind-config ]]; then
    select_mode kind
    lab_resolve kind >/dev/null
    kind_render_config
    return
  fi
  if [[ -z "${1:-}" && -z "${DEPLOYMENT_MODE:-}" ]]; then
    info "Aucun mode précisé (DEPLOYMENT_MODE vide) : configuration résolue pour le mode kind."
    set -- kind
  fi
  select_mode "$@"
  local args=(--mode "${LAB_MODE}")
  [[ -z "${LAB_PROVIDER}" ]] || args+=(--provider "${LAB_PROVIDER}")
  labctl show "${args[@]}"
}

cmd_validate() {
  select_mode "$@"
  lab_resolve "${LAB_MODE}" "${LAB_PROVIDER}"
}

# dispatch <action> [mode] [provider] : action d'un mode (deploy, destroy, kubeconfig).
dispatch() {
  local action="$1"
  shift
  select_mode "$@"
  # Toujours valider avant d'agir ; destroy reste possible même si la configuration a changé.
  if [[ "${action}" == destroy ]]; then
    labctl shell --mode "${LAB_MODE}" ${LAB_PROVIDER:+--provider "${LAB_PROVIDER}"} >/dev/null 2>&1 &&
      eval "$(labctl shell --mode "${LAB_MODE}" ${LAB_PROVIDER:+--provider "${LAB_PROVIDER}"})"
  else
    lab_resolve "${LAB_MODE}" "${LAB_PROVIDER}"
  fi
  case "${LAB_MODE}" in
    terraform) "terraform_${action}" "${LAB_PROVIDER}" ;;
    *) "${LAB_MODE}_${action}" ;;
  esac
}

# Commandes d'exploitation : <commande> [mode] [provider] après validation.
day2() {
  local function="$1"
  shift
  select_mode "$@"
  lab_resolve "${LAB_MODE}" "${LAB_PROVIDER}"
  "${function}"
}

cmd_kubeconfig() {
  require_kubectl
  if [[ -z "${1:-}" ]]; then
    if [[ -s "${LAB_KUBECONFIG}" ]]; then
      KUBECONFIG="${LAB_KUBECONFIG}" run kubectl config get-contexts
      kubeconfig_hint "$(KUBECONFIG="${LAB_KUBECONFIG}" kubectl config current-context 2>/dev/null || echo '<contexte>')"
    else
      info "Aucun cluster dans .kube/config. Déployez-en un : $(hint_cmd deploy kind)"
    fi
    return
  fi
  dispatch kubeconfig "$@"
}

# --- Menu interactif --------------------------------------------------------------

pause() {
  printf '\n%sAppuyez sur Entrée pour revenir au menu...%s' "${C_DIM}" "${C_RESET}"
  read -r _ || true
}

# Exécute une commande du CLI dans un sous-processus : une erreur ne ferme pas le menu.
menu_run() {
  "${LAB_ROOT}/k8s-lab" "$@" || true
  pause
}

menu_choose_provider() {
  local choice
  # Affichage sur stderr : stdout ne contient que la réponse (capturée par l'appelant).
  printf '\n  a) Proxmox VE\n  b) VMware vSphere (vCenter)\n  c) libvirt/KVM (votre machine Linux)\n\n' >&2
  read -r -p "Provider Terraform [a/b/c] : " choice || true
  case "${choice}" in
    a | A) echo proxmox ;;
    b | B) echo vsphere ;;
    c | C) echo libvirt ;;
    *) warn "Choix invalide : ${choice}" ;;
  esac
  return 0
}

menu_choose_mode() {
  local choice provider
  printf '\n  1) Kind   2) Minikube   3) Vagrant   4) Terraform (VMs)   5) AWS EKS\n\n' >&2
  read -r -p "Quel cluster ? [1-5] : " choice || true
  case "${choice}" in
    1) echo kind ;;
    2) echo minikube ;;
    3) echo vagrant ;;
    4)
      provider="$(menu_choose_provider)"
      if [[ -n "${provider}" ]]; then echo "terraform ${provider}"; fi
      ;;
    5) echo "terraform eks" ;;
    *) warn "Choix invalide : ${choice}" ;;
  esac
  return 0
}

menu() {
  local choice target
  while true; do
    printf '\n%s════════════════════════════════════════════════════════%s\n' "${C_BLUE}" "${C_RESET}"
    printf '  %sKubernetes Lab%s — cluster "%s"\n' "${C_BOLD}" "${C_RESET}" "${CLUSTER_NAME}"
    printf '%s════════════════════════════════════════════════════════%s\n' "${C_BLUE}" "${C_RESET}"
    cat <<MENU

Choisissez une méthode de déploiement :

  1. Kind              Cluster local rapide dans Docker     (débutant)
  2. Minikube          Cluster local avec addons            (débutant)
  3. Vagrant           VMs + Ansible + kubeadm              (intermédiaire)
  4. Terraform         VMs + Ansible + kubeadm              (avancé)
     ├─ Proxmox
     ├─ VMware/vSphere
     └─ libvirt/KVM
  5. AWS EKS           Kubernetes managé dans le cloud      (cloud, payant)
  e. Machines existantes  kubeadm sur vos serveurs (EXISTING_INVENTORY)
  a. Cluster existant     addons seulement (EXISTING_KUBECONFIG/CONTEXT)

  6. Détruire un cluster
  7. Vérifier les prérequis (doctor)
  8. État des clusters (status)
  9. Tester le cluster actif (nginx)
  q. Quitter

MENU
    read -r -p "Votre choix [1-9, e, a, q] : " choice || exit 0
    case "${choice}" in
      1) menu_run deploy kind ;;
      2) menu_run deploy minikube ;;
      3) menu_run deploy vagrant ;;
      4)
        target="$(menu_choose_provider)"
        if [[ -n "${target}" ]]; then menu_run deploy terraform "${target}"; fi
        ;;
      5) menu_run deploy terraform eks ;;
      e | E) menu_run deploy existing ;;
      a | A) menu_run deploy attach ;;
      6)
        target="$(menu_choose_mode)"
        # shellcheck disable=SC2086 # "terraform proxmox" doit donner deux arguments
        if [[ -n "${target}" ]]; then menu_run destroy ${target}; fi
        ;;
      7) menu_run doctor ;;
      8) menu_run status ;;
      9) menu_run test ;;
      q | Q) exit 0 ;;
      *) warn "Choix invalide : ${choice}" ;;
    esac
  done
}

# --- Point d'entrée -----------------------------------------------------------------

main() {
  local args=() arg
  ASSUME_YES="${ASSUME_YES:-0}"
  RECREATE="${RECREATE:-0}"
  KEEP="${KEEP:-0}"
  ADDON="${ADDON:-}"
  DESTRUCTIVE_TESTS="${DESTRUCTIVE_TESTS:-0}"
  local expect_addon=0
  for arg in "$@"; do
    if ((expect_addon)); then
      ADDON="${arg}"
      expect_addon=0
      continue
    fi
    case "${arg}" in
      -y | --yes) ASSUME_YES=1 ;;
      --recreate) RECREATE=1 ;;
      --keep) KEEP=1 ;;
      --destructive) DESTRUCTIVE_TESTS=1 ;;
      --addon=*) ADDON="${arg#--addon=}" ;;
      --addon) expect_addon=1 ;;
      -h | --help) args=(help) ;;
      -*) die "Option inconnue : ${arg}" "Aide : $(hint_cmd help)" ;;
      *) args+=("${arg}") ;;
    esac
  done
  ((expect_addon == 0)) || die "--addon attend un nom d'addon (ex : --addon cert-manager)."
  export ASSUME_YES RECREATE KEEP ADDON DESTRUCTIVE_TESTS

  load_config
  ensure_state_dirs
  cd "${LAB_ROOT}"

  if ((${#args[@]} == 0)); then
    if [[ -t 0 && -t 1 ]]; then
      menu
    else
      usage
    fi
    return
  fi

  local command="${args[0]}"
  local rest=("${args[@]:1}")
  case "${command}" in
    help) usage ;;
    doctor) cmd_doctor ${rest[@]+"${rest[@]}"} || exit 1 ;;
    deploy)
      if ((${#rest[@]} == 0)) && [[ -z "${DEPLOYMENT_MODE:-}" ]]; then
        info "Aucun mode précisé : kind est utilisé (le plus simple). Autres modes : $(hint_cmd help)"
        rest=(kind)
      fi
      dispatch deploy ${rest[@]+"${rest[@]}"}
      ;;
    destroy) dispatch destroy ${rest[@]+"${rest[@]}"} ;;
    uninstall) day2 cmd_uninstall ${rest[@]+"${rest[@]}"} ;;
    status) cmd_status ;;
    kubeconfig) cmd_kubeconfig ${rest[@]+"${rest[@]}"} ;;
    test)
      require_kubectl
      if [[ "${KEEP}" == "1" ]]; then smoke_app --keep; else smoke_app --cleanup; fi
      ;;
    config) cmd_config ${rest[@]+"${rest[@]}"} ;;
    validate) cmd_validate ${rest[@]+"${rest[@]}"} ;;
    plan | addons-plan) cmd_addons plan ${rest[@]+"${rest[@]}"} ;;
    addons-apply | addons-status | addons-test | addons-upgrade | addons-remove | addons-catalog)
      cmd_addons "${command#addons-}" ${rest[@]+"${rest[@]}"}
      ;;
    upgrade-plan) day2 cmd_upgrade_plan ${rest[@]+"${rest[@]}"} ;;
    upgrade) day2 cmd_upgrade ${rest[@]+"${rest[@]}"} ;;
    os-update) day2 cmd_os_update ${rest[@]+"${rest[@]}"} ;;
    backup) day2 cmd_backup ${rest[@]+"${rest[@]}"} ;;
    restore) day2 cmd_restore ${rest[@]+"${rest[@]}"} ;;
    health) day2 cmd_health ${rest[@]+"${rest[@]}"} ;;
    node-remove) day2 cmd_node_remove ${rest[@]+"${rest[@]}"} ;;
    storage-failure-test) day2 cmd_storage_failure_test ${rest[@]+"${rest[@]}"} ;;
    manifest) day2 lab_write_manifest ${rest[@]+"${rest[@]}"} ;;
    versions) labctl versions ;;
    versions-check) labctl versions-check ;;
    *) die "Commande inconnue : \"${command}\"." "Aide : $(hint_cmd help)" ;;
  esac
}

main "$@"
