# E2E (CI) : kind + Envoy Gateway + MetalLB (pool dans le réseau Docker « kind ») +
# metrics-server, cert-manager, Reloader, External Secrets.
DEPLOYMENT_MODE=kind
CLUSTER_NAME=e2e-core
WORKER_COUNT=2
GATEWAY_CONTROLLER=envoy-gateway
GATEWAY_DOMAIN=k8s-lab.test
LOADBALANCER_PROVIDER=metallb
LOADBALANCER_IP_POOL=172.18.255.200-172.18.255.230
ADDON_PROFILE=minimal
ADDONS=metrics-server,cert-manager,reloader,external-secrets
