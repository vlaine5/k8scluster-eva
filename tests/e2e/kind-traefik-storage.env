# E2E (CI) : kind + Traefik + MetalLB + NFS CSI (serveur NFS de test dans le cluster) +
# snapshots, Velero (S3 de test VersityGW), Argo CD, Kyverno (audit), KEDA, Descheduler, NFD.
DEPLOYMENT_MODE=kind
CLUSTER_NAME=e2e-storage
WORKER_COUNT=2
GATEWAY_CONTROLLER=traefik
GATEWAY_DOMAIN=k8s-lab.test
LOADBALANCER_PROVIDER=metallb
LOADBALANCER_IP_POOL=172.18.255.200-172.18.255.230
STORAGE_BACKENDS=nfs-csi
NFS_SERVER=nfs-server.nfs-test.svc.cluster.local
NFS_SHARE=/
VELERO_S3_URL=http://s3.s3-test.svc.cluster.local:9000
VELERO_BUCKET=velero
VELERO_FS_BACKUP=false
ADDON_PROFILE=minimal
ADDONS=cert-manager,snapshot-controller,velero,argo-cd,kyverno,keda,descheduler,node-feature-discovery
KYVERNO_POLICY_MODE=audit
