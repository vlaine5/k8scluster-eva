# E2E (CI) : kind avec Cilium (remplacement de kube-proxy) + Cilium Gateway API +
# LB IPAM L2 + Hubble + Tetragon + cert-manager.
DEPLOYMENT_MODE=kind
CLUSTER_NAME=e2e-cilium
WORKER_COUNT=2
CNI=cilium
GATEWAY_CONTROLLER=cilium
GATEWAY_DOMAIN=k8s-lab.test
LOADBALANCER_PROVIDER=cilium-l2
LOADBALANCER_IP_POOL=172.18.255.200-172.18.255.230
ENABLE_HUBBLE=true
ADDON_PROFILE=minimal
ADDONS=cert-manager,metrics-server,tetragon
