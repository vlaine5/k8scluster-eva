# E2E (CI) : mode attach sur un cluster kind créé HORS du framework, où metrics-server
# a déjà été installé par « un autre outil » (release Helm other-metrics).
# EXISTING_KUBECONFIG (chemin absolu) est fourni par le workflow.
DEPLOYMENT_MODE=attach
EXISTING_CONTEXT=kind-attach-target
CLUSTER_NAME=attach-target
ADDON_PROFILE=custom
ADDONS=metrics-server,cert-manager
EXISTING_ADDON_POLICY=fail
