# Scénario de rendu : kubeadm (Vagrant), Calico, Envoy Gateway, MetalLB BGP, ACME HTTP-01.
DEPLOYMENT_MODE=vagrant
CLUSTER_NAME=render-envoy
CONTROL_PLANE_COUNT=1
WORKER_COUNT=2
CNI=calico
GATEWAY_CONTROLLER=envoy-gateway
LOADBALANCER_PROVIDER=metallb
LOADBALANCER_MODE=bgp
LOADBALANCER_IP_POOL=10.200.0.0/28
BGP_LOCAL_ASN=64513
BGP_PEER_ADDRESS=192.168.56.1
BGP_PEER_ASN=64512
ADDON_PROFILE=homelab
ADDONS=+external-dns,+logging
CERT_MANAGER_ISSUER=acme-http01
ACME_EMAIL=admin@example.org
EXTERNAL_DNS_PROVIDER=pihole
EXTERNAL_DNS_DOMAIN_FILTER=lab.example.org
PIHOLE_SERVER=http://192.168.56.5
KYVERNO_POLICY_MODE=none
