# Scénario de rendu : kubeadm (Vagrant), 3 control planes, Cilium (Gateway, LB L2, Hubble),
# stockage NFS + Longhorn, profil enterprise-lab + addons supplémentaires.
# Aucune valeur secrète ici : tests/addons/render-check fournit des valeurs factices.
DEPLOYMENT_MODE=vagrant
CLUSTER_NAME=render-full
CONTROL_PLANE_COUNT=3
WORKER_COUNT=3
NODE_CPUS=4
NODE_MEMORY_MB=8192
NODE_DISK_GB=60
CNI=cilium
GATEWAY_CONTROLLER=cilium
LOADBALANCER_PROVIDER=cilium-l2
LOADBALANCER_IP_POOL=192.168.56.200-192.168.56.220
ENABLE_HUBBLE=true
HUBBLE_UI=true
STORAGE_BACKENDS=nfs-csi,longhorn
DEFAULT_STORAGE_CLASS=longhorn
NFS_SERVER=192.168.56.2
NFS_SHARE=/volume1/kubernetes
LONGHORN_DEDICATED_DISK=true
LONGHORN_BACKUP_ENABLED=true
LONGHORN_BACKUP_TARGET=s3://longhorn@minio/
LONGHORN_UI_EXPOSE=true
ADDON_PROFILE=enterprise-lab
ADDONS=+tempo,+opentelemetry-collector,+velero,+tetragon,+keda,+descheduler,+node-feature-discovery,+snapshot-controller,+external-dns,+istio
CERT_MANAGER_ISSUER=acme-dns01
ACME_EMAIL=admin@example.org
ACME_DNS01_PROVIDER=rfc2136
RFC2136_NAMESERVER=192.168.56.3:53
RFC2136_TSIG_KEY_NAME=k8s-lab
EXTERNAL_DNS_PROVIDER=rfc2136
EXTERNAL_DNS_DOMAIN_FILTER=lab.example.org
GATEWAY_DOMAIN=lab.example.org
ARGOCD_REPO_URL=https://github.com/vlaine5/k8scluster-eva.git
ARGOCD_AUTO_SYNC=true
ARGOCD_EXPOSE=true
GRAFANA_EXPOSE=true
MONITORING_PERSISTENCE=true
LOGGING_PERSISTENCE=true
LOGGING_NODE_LOGS=true
KYVERNO_POLICY_MODE=enforce
BACKUP_ENABLED=true
BACKUP_PROVIDER=both
VELERO_S3_URL=http://192.168.56.4:9000
VELERO_BUCKET=velero
