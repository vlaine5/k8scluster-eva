# Scénario de rendu : kind (CI), Traefik, MetalLB L2, NFS CSI, profil observability.
DEPLOYMENT_MODE=kind
CLUSTER_NAME=render-kind
WORKER_COUNT=2
GATEWAY_CONTROLLER=traefik
LOADBALANCER_PROVIDER=metallb
LOADBALANCER_IP_POOL=172.18.255.200-172.18.255.250
STORAGE_BACKENDS=nfs-csi
NFS_SERVER=nfs-server.nfs-test.svc.cluster.local
NFS_SHARE=/
ADDON_PROFILE=observability
ADDONS=+cert-manager,+falco,+reloader,+external-secrets,+argo-cd,+kyverno,+trivy-operator,+snapshot-controller
KYVERNO_POLICY_MODE=audit
