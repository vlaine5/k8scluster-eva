#!/usr/bin/env python3
"""Vérification hors cluster des addons : pour chaque scénario de tests/addons/scenarios,
résout la configuration (scripts/labctl), rend tous les modèles (Ansible), puis valide
chaque release avec « helm template » (chart et version verrouillés) et chaque manifeste.

    tests/addons/render-check                  # tous les scénarios
    tests/addons/render-check kind-traefik     # un scénario
    tests/addons/render-check --keep DIR ...   # conserver les rendus (valeurs, manifestes, sorties helm)

Prérequis : helm, ansible-playbook, PyYAML ; accès réseau aux dépôts de charts (cache
dans .lab/cache/charts). Aucun cluster n'est contacté.
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[2]
SCENARIOS = ROOT / "tests" / "addons" / "scenarios"
CACHE = ROOT / ".lab" / "cache" / "charts"

