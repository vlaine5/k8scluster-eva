DUMMY_SECRETS = {
    "GRAFANA_ADMIN_PASSWORD": "dummy-grafana-password-7f3a",
    "ARGOCD_REPO_USERNAME": "dummy-git-user",
    "ARGOCD_REPO_PASSWORD": "dummy-git-token-91bc",
    "RFC2136_TSIG_SECRET": "ZHVtbXktdHNpZy1zZWNyZXQtNDRlMQ==",
    "CLOUDFLARE_API_TOKEN": "dummy-cloudflare-token-3d2e",
    "PIHOLE_PASSWORD": "dummy-pihole-password-b81c",
    "VELERO_S3_ACCESS_KEY": "dummy-velero-access-5c6d",
    "VELERO_S3_SECRET_KEY": "dummy-velero-secret-0a9f",
    "LONGHORN_BACKUP_S3_ACCESS_KEY": "dummy-longhorn-access-77e2",
    "LONGHORN_BACKUP_S3_SECRET_KEY": "dummy-longhorn-secret-12ab",
    "LONGHORN_BACKUP_S3_ENDPOINT": "http://minio.example.invalid:9000",
}
# APIs supposées présentes (CRD installées par d'autres addons du même plan).
API_VERSIONS = [
    "monitoring.coreos.com/v1", "gateway.networking.k8s.io/v1", "gateway.networking.k8s.io/v1beta1",
    "cert-manager.io/v1", "snapshot.storage.k8s.io/v1", "policy/v1", "autoscaling/v2",
]


class Loader(yaml.SafeLoader):
    """Tolère les étiquettes YAML exotiques de certains charts (ex. « = »)."""


Loader.add_constructor("tag:yaml.org,2002:value", lambda loader, node: loader.construct_scalar(node))


def run(argv: list[str], env: dict[str, str] | None = None, cwd: Path = ROOT) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True, env=env, cwd=cwd, stdin=subprocess.DEVNULL)


def chart_dir(component: dict, chart_key: str) -> tuple[Path | None, str]:
    ref = component[chart_key] if component["type"] == "helm-oci" else component["chart"]
    name = ref.rstrip("/").split("/")[-1]
    target = CACHE / f"{name}-{component['version']}"
    if (target / name / "Chart.yaml").is_file():
        return target / name, ""
    target.mkdir(parents=True, exist_ok=True)
    argv = ["helm", "pull", ref, "--version", component["version"], "--untar", "--untardir", str(target)]
    if component["type"] == "helm":
        argv[2:3] = [ref, "--repo", component["repo"]]
    result = run(argv)
    if result.returncode != 0:
        return None, f"helm pull {ref} {component['version']} : {result.stderr.strip()[:300]}"
    return target / name, ""


def check_docs(text: str, origin: str, problems: list[str]) -> int:
    count = 0
    try:
        docs = [d for d in yaml.load_all(text, Loader=Loader) if d]
    except yaml.YAMLError as exc:
        problems.append(f"{origin} : YAML invalide : {exc}")
        return 0
    for doc in docs:
        if not isinstance(doc, dict) or not doc.get("apiVersion") or not doc.get("kind") \
                or not (doc.get("metadata") or {}).get("name"):
            problems.append(f"{origin} : document sans apiVersion/kind/metadata.name : {str(doc)[:120]}")
        count += 1
    return count


# Pod Security Standards (vérification simplifiée des règles qui font échouer un
# déploiement) : chaque workload du namespace d'un addon doit respecter le niveau
# déclaré par install.pod_security (étiquette pod-security.kubernetes.io/enforce).
WORKLOADS = {"Deployment", "StatefulSet", "DaemonSet", "ReplicaSet", "Job", "Pod"}
BASELINE_CAPS = {"AUDIT_WRITE", "CHOWN", "DAC_OVERRIDE", "FOWNER", "FSETID", "KILL", "MKNOD",
                 "NET_BIND_SERVICE", "SETFCAP", "SETGID", "SETPCAP", "SETUID", "SYS_CHROOT"}


def pod_spec(doc: dict) -> dict | None:
    kind = doc.get("kind")
    if kind == "Pod":
        return doc.get("spec") or {}
    if kind == "CronJob":
        return (((doc.get("spec") or {}).get("jobTemplate") or {}).get("spec") or {}).get("template", {}).get("spec")
    if kind in WORKLOADS:
        return ((doc.get("spec") or {}).get("template") or {}).get("spec")
    return None


def pod_security_violations(spec: dict, level: str) -> list[str]:
    found = []
    pod_ctx = spec.get("securityContext") or {}
    containers = [c for key in ("initContainers", "containers") for c in spec.get(key) or []]
    for flag in ("hostNetwork", "hostPID", "hostIPC"):
        if spec.get(flag):
            found.append(flag)
    if any("hostPath" in v for v in spec.get("volumes") or []):
        found.append("volume hostPath")
    for c in containers:
        ctx = c.get("securityContext") or {}
        name = c.get("name", "?")
        caps = ctx.get("capabilities") or {}
        if ctx.get("privileged"):
            found.append(f"{name}: privileged")
        if any(p.get("hostPort") for p in c.get("ports") or []):
            found.append(f"{name}: hostPort")
        if set(caps.get("add") or []) - BASELINE_CAPS:
            found.append(f"{name}: capacités {sorted(set(caps.get('add')) - BASELINE_CAPS)}")
        if level != "restricted":
            continue
        if ctx.get("allowPrivilegeEscalation") is not False:
            found.append(f"{name}: allowPrivilegeEscalation != false")
        if "ALL" not in (caps.get("drop") or []):
            found.append(f"{name}: capabilities.drop sans ALL")
        if set(caps.get("add") or []) - {"NET_BIND_SERVICE"}:
            found.append(f"{name}: capacités ajoutées")
        if not (ctx.get("runAsNonRoot", pod_ctx.get("runAsNonRoot")) is True):
            found.append(f"{name}: runAsNonRoot != true")
        if ctx.get("runAsUser", pod_ctx.get("runAsUser")) == 0:
            found.append(f"{name}: runAsUser=0")
        seccomp = (ctx.get("seccompProfile") or pod_ctx.get("seccompProfile") or {}).get("type")
        if seccomp not in ("RuntimeDefault", "Localhost"):
            found.append(f"{name}: seccompProfile absent")
    return found


def check_pod_security(text: str, origin: str, namespace: str, level: str, problems: list[str]) -> None:
    # kube-system et default ne reçoivent jamais d'étiquette Pod Security du framework.
    if level == "privileged" or namespace in ("kube-system", "default"):
        return
    for doc in yaml.load_all(text, Loader=Loader):
        if not isinstance(doc, dict) or (doc.get("metadata") or {}).get("namespace", namespace) != namespace:
            continue
        spec = pod_spec(doc)
        if spec is None:
            continue
        violations = pod_security_violations(spec, level)
        if violations:
            problems.append(f"{origin} : {doc['kind']}/{doc['metadata']['name']} refusé en Pod Security "
                            f"« {level} » (namespace {namespace}) : {', '.join(violations)}")


def render_core(data: dict, vars_file: Path, workdir: Path, render_dir: Path, env: dict) -> list[str]:
    """Rend les modèles des rôles kubeadm sur un inventaire fictif (N control-planes du
    scénario + 2 workers, tous locaux) : tout YAML invalide fait échouer le rendu."""
    cps = max(int(data.get("control_plane_count") or 1), 1)
    lines = ["[control_plane]"]
    lines += [f"k8s-cp-{i} node_ip=192.0.2.{9 + i}" for i in range(1, cps + 1)]
    lines += ["", "[workers]"] + [f"k8s-worker-{i} node_ip=192.0.2.{19 + i}" for i in (1, 2)]
    lines += ["", "[k8s_cluster:children]", "control_plane", "workers", "",
              "[k8s_cluster:vars]", "ansible_python_interpreter=auto_silent", ""]
    # group_vars à côté de l'inventaire, comme en réel : visibles dans hostvars des autres nœuds.
    (workdir / "core-inventory" / "group_vars").mkdir(parents=True, exist_ok=True)
    shutil.copy(ROOT / "ansible" / "group_vars" / "all.yml", workdir / "core-inventory" / "group_vars" / "all.yml")
    inventory = workdir / "core-inventory" / "hosts.ini"
    inventory.write_text("\n".join(lines))
    lock = workdir / "lock.json"
    lock.write_text(json.dumps({"lab_lock": yaml.safe_load((ROOT / "config" / "versions.yaml").read_text())}))
    result = run(["ansible-playbook", "-i", str(inventory), str(ROOT / "tests" / "addons" / "render_core.yml"),
                  "-e", f"@{vars_file}", "-e", f"@{lock}", "-e", f"render_dir={render_dir}",
                  "-e", "cluster_name=render-check"], env={**env, "ANSIBLE_STDOUT_CALLBACK": "default"})
    if result.returncode != 0:
        tail = "\n".join((result.stdout + result.stderr).splitlines()[-30:])
        return [f"rendu des rôles kubeadm en échec :\n{tail}"]
    count = len(list((render_dir / "core").rglob("*")))
    print(f"  rôles kubeadm : {count} fichiers rendus ({cps} control-plane(s) + 2 workers)")
    return []


def scenario(path: Path, workdir: Path) -> list[str]:
    problems: list[str] = []
    env = {**os.environ, **DUMMY_SECRETS, "LAB_ENV_FILE": str(path), "NO_COLOR": "1"}
    vars_file = workdir / "vars.json"
    result = run([sys.executable, str(ROOT / "scripts" / "labctl"), "ansible-vars", "--output", str(vars_file)], env=env)
    if result.returncode != 0:
        return [f"labctl : configuration refusée :\n{result.stdout}{result.stderr}"]
    data = json.loads(vars_file.read_text())
    render_dir = workdir / "render"
    result = run(["ansible-playbook", str(ROOT / "tests" / "addons" / "render.yml"), "-e", f"@{vars_file}",
                  "-e", f"render_dir={render_dir}"], env={**env, "ANSIBLE_STDOUT_CALLBACK": "default"})
    if result.returncode != 0:
        tail = "\n".join((result.stdout + result.stderr).splitlines()[-25:])
        return [f"rendu Ansible en échec :\n{tail}"]
    kube_version = data["kubernetes_version"]
    releases = objects = 0
    for addon in data["lab_addons"]:
        install = addon["spec"].get("install", {})
        for release in install.get("releases", []):
            if not release.get("enabled", True):
                continue
            component = addon["components"][release["component"]]
            chart, error = chart_dir(component, release.get("chart_key", "chart"))
            if error:
                problems.append(f"{addon['id']}/{release['name']} : {error}")
                continue
            argv = ["helm", "template", release["name"], str(chart), "-n", release["namespace"],
                    "--kube-version", kube_version]
            for api in API_VERSIONS:
                argv += ["--api-versions", api]
            if release.get("skip_crds"):
                argv.append("--skip-crds")
            values = render_dir / addon["id"] / f"{release['name']}.values.yaml"
            if release.get("values"):
                rendered = values.read_text()
                try:
                    yaml.safe_load(rendered)
                except yaml.YAMLError as exc:
                    problems.append(f"{addon['id']}/{release['name']} : valeurs YAML invalides : {exc}")
                    continue
                argv += ["-f", str(values)]
            result = run(argv)
            if result.returncode != 0:
                problems.append(f"{addon['id']}/{release['name']} : helm template : {result.stderr.strip()[:600]}")
                continue
            releases += 1
            (render_dir / addon["id"] / f"{release['name']}.rendered.yaml").write_text(result.stdout)
            objects += check_docs(result.stdout, f"{addon['id']}/{release['name']}", problems)
            if install.get("namespace"):
                check_pod_security(result.stdout, f"{addon['id']}/{release['name']}", install["namespace"],
                                   install.get("pod_security", "baseline"), problems)
        for manifest in (render_dir / addon["id"] / "manifests").glob("*"):
            objects += check_docs(manifest.read_text(), f"{addon['id']}/manifests/{manifest.name}", problems)
            if install.get("namespace"):
                check_pod_security(manifest.read_text(), f"{addon['id']}/manifests/{manifest.name}",
                                   install["namespace"], install.get("pod_security", "baseline"), problems)
    # Modèles des rôles kubeadm (kubeadm, CNI, kube-vip...) pour les plateformes kubeadm.
    if data.get("lab_platform") in ("vagrant", "terraform", "existing"):
        problems += render_core(data, vars_file, workdir, render_dir, env)
    # Aucun secret ne doit se retrouver dans les variables ou les fichiers rendus.
    for file in [vars_file, *render_dir.rglob("*")]:
        if file.is_file():
            text = file.read_text(errors="replace")
            for key, value in DUMMY_SECRETS.items():
                if value in text and not key.endswith("_ENDPOINT"):
                    problems.append(f"FUITE : la valeur de {key} apparaît dans {file.relative_to(workdir)}")
    print(f"  {len(data['lab_addons'])} addons, {releases} releases Helm rendues, {objects} objets vérifiés")
    return problems


def main() -> int:
    wanted = sys.argv[1:]
    keep = None
    if wanted[:1] == ["--keep"] and len(wanted) > 1:
        keep, wanted = Path(wanted[1]).resolve(), wanted[2:]
    files = sorted(SCENARIOS.glob("*.env"))
    if wanted:
        files = [f for f in files if f.stem in wanted]
        if len(files) != len(wanted):
            sys.stderr.write(f"Scénarios disponibles : {', '.join(f.stem for f in sorted(SCENARIOS.glob('*.env')))}\n")
            return 2
    failed = 0
    for path in files:
        print(f"== {path.stem}")
        with tempfile.TemporaryDirectory(prefix="k8s-lab-render-") as tmp:
            problems = scenario(path, Path(tmp))
            if keep:
                shutil.copytree(Path(tmp), keep / path.stem, dirs_exist_ok=True)
        for problem in problems:
            print(f"  [erreur] {problem}")
        failed += bool(problems)
        print("  OK" if not problems else f"  {len(problems)} problème(s)")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
