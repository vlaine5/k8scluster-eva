# =============================================================================
#  Nœud de TEST Rocky Linux : un conteneur systemd qui imite une machine
#  existante (utilisateur "rocky" du groupe wheel, sudo sans mot de passe,
#  SSH par clé). Utilisé uniquement par tests/kubeadm-in-docker/run.sh.
#  SSH sans PAM (UsePAM no) sur ces nœuds de test uniquement : dans un conteneur
#  systemd, la pile PAM « account » de sshd refuse les connexions par clé (« Access
#  denied ... by PAM account configuration »), alors que la même image fonctionne hors
#  conteneur (vérifié en chroot Rocky 9.8, OpenSSH 9.9). Mot de passe « * » au lieu de
#  « !! » : sans PAM, sshd considère « ! » comme un compte verrouillé. Pour la même
#  raison, sudo n'y consulte pas la pile PAM « account » (Defaults !pam_acct_mgmt).
#  Sans effet sur les vraies machines Rocky, que le framework ne modifie pas sur ce point.
# =============================================================================
ARG BASE_IMAGE=docker.io/rockylinux/rockylinux:9
FROM ${BASE_IMAGE}

ARG NODE_USER=rocky
ENV container=docker

RUN dnf install -y -q systemd openssh-server sudo python3 ca-certificates iproute kmod procps-ng \
    && dnf clean all

RUN useradd -m -s /bin/bash -G wheel "${NODE_USER}" \
    && printf '%s ALL=(ALL) NOPASSWD:ALL\nDefaults:%s !pam_acct_mgmt\n' "${NODE_USER}" "${NODE_USER}" > "/etc/sudoers.d/${NODE_USER}" \
    && chmod 0440 "/etc/sudoers.d/${NODE_USER}" && visudo -cq \
    && install -d -m 0700 -o "${NODE_USER}" -g "${NODE_USER}" "/home/${NODE_USER}/.ssh" \
    && rm -f /etc/ssh/ssh_host_* \
    && rm -f /usr/lib/tmpfiles.d/systemd-nologin.conf \
    && usermod -p '*' "${NODE_USER}" \
    && printf 'UsePAM no\n' > /etc/ssh/sshd_config.d/00-k8s-lab-test.conf \
    && printf '[Unit]\nBefore=sshd.service\n[Service]\nType=oneshot\nExecStart=/usr/bin/ssh-keygen -A\n[Install]\nWantedBy=multi-user.target\n' \
       > /etc/systemd/system/ssh-host-keys.service \
    && systemctl enable sshd ssh-host-keys.service

# Montages en propagation partagée, comme sur une vraie machine : systemd le fait au
# démarrage, sauf dans un conteneur. Sans cela, les Pods qui montent /sys/fs en
# propagation bidirectionnelle (init container eBPF de calico-node) ne démarrent pas
# (« /sys/fs is mounted on /sys but it is not a shared mount »). kind fait de même.
RUN printf '[Unit]\nDefaultDependencies=no\nBefore=local-fs.target\n[Service]\nType=oneshot\nExecStart=/usr/bin/mount --make-rshared /\n[Install]\nWantedBy=sysinit.target\n' \
       > /etc/systemd/system/k8s-lab-test-rshared.service \
    && systemctl enable k8s-lab-test-rshared.service

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
