# =============================================================================
#  k8s-lab — configuration par défaut (versionnée dans Git)
# =============================================================================
#
#  C'est LE fichier central du lab : tous les modes (kind, minikube, vagrant,
#  terraform) lisent leurs réglages ici, via ./k8s-lab.
#
#  Ne modifiez pas ce fichier pour vos essais personnels : copiez plutôt
#  .env.example en .env (ignoré par Git) et surchargez-y les valeurs voulues.
#
#  Ordre de priorité (le premier trouvé gagne) :
#    1. variable d'environnement      ex : WORKER_COUNT=3 ./k8s-lab deploy kind
#    2. argument make                 ex : make deploy MODE=kind WORKERS=3
#    3. fichier .env                  (vos réglages / secrets, non versionné)
#    4. ce fichier config/lab.env     (valeurs par défaut)
#
#  Format : une ligne CLE=valeur, sans espace autour du "=".
#  Les commentaires doivent être sur leur propre ligne.
#
#  Correspondance détaillée avec Terraform / Ansible / Vagrant :
#  docs/configuration.md
# =============================================================================

# -----------------------------------------------------------------------------
#  Forme du cluster (tous les modes)
# -----------------------------------------------------------------------------
# Nom du cluster : sert au nom du contexte kubectl et au préfixe des ressources.
CLUSTER_NAME=k8s-lab
# Nombre de workers (0 = cluster mono-nœud). Le control-plane est toujours unique.
WORKER_COUNT=2

# -----------------------------------------------------------------------------
#  Machines virtuelles (vagrant + terraform)
# -----------------------------------------------------------------------------
# Préfixe des hostnames : k8s-cp-1, k8s-worker-1, k8s-worker-2, ...
NODE_HOSTNAME_PREFIX=k8s
# kubeadm exige au moins 2 vCPU et ~1,7 Go de RAM sur le control-plane.
NODE_CPUS=2
NODE_MEMORY_MB=2048
NODE_DISK_GB=20
# Clé SSH utilisée par Ansible. Vide = une clé dédiée au lab est générée
# automatiquement dans .lab/ssh/ (recommandé : on ne réutilise pas votre clé perso).
SSH_PRIVATE_KEY_FILE=

# Image cloud Ubuntu 24.04 LTS (release datée = reproductible) + son SHA-256
# (fichier SHA256SUMS de la release). Utilisée par Terraform proxmox et libvirt.
VM_IMAGE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260911/ubuntu-24.04-server-cloudimg-amd64.img
VM_IMAGE_SHA256=612b2c0cc1bc413a6cb8c38fd611794caf0f2b436c50013d8b3794db12ad7354

# -----------------------------------------------------------------------------
#  Kubernetes installé par kubeadm (modes vagrant + terraform, via Ansible)
# -----------------------------------------------------------------------------
# Version complète (le dépôt APT pkgs.k8s.io est déduit : v1.37).
KUBERNETES_VERSION=1.37.1
# Réseau des Pods (doit correspondre au CNI) et réseau des Services.
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
# CNI : flannel (par défaut) ou none (vous installez votre CNI vous-même).
CNI=flannel
FLANNEL_VERSION=v0.28.9
# Runtime de conteneurs : seul containerd est supporté (paquet containerd.io).
CONTAINER_RUNTIME=containerd
# Motif de version APT du paquet containerd.io (2.x requis).
CONTAINERD_VERSION=2.3.*

# -----------------------------------------------------------------------------
#  Kind (Kubernetes dans des conteneurs Docker)
# -----------------------------------------------------------------------------
# Image épinglée par digest : celle publiée avec kind v0.33.0 pour Kubernetes v1.37.0.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# Chemin d'une config kind personnalisée (vide = générée depuis ces réglages,
# voir local/kind/kind-config.yaml).
KIND_CONFIG=

# -----------------------------------------------------------------------------
#  Minikube
# -----------------------------------------------------------------------------
MINIKUBE_KUBERNETES_VERSION=v1.37.0
# Driver : vide = détection automatique (docker, podman, kvm2, virtualbox...).
MINIKUBE_DRIVER=
# Minikube est utilisé en mono-nœud par défaut (usage "découverte" + addons).
MINIKUBE_NODES=1
MINIKUBE_CPUS=2
MINIKUBE_MEMORY_MB=2048
# Options supplémentaires passées à "minikube start" (ex : --addons=ingress).
MINIKUBE_EXTRA_ARGS=

# -----------------------------------------------------------------------------
#  Vagrant
# -----------------------------------------------------------------------------
# virtualbox (défaut) | libvirt | vmware_desktop | vmware_esxi (historique)
VAGRANT_PROVIDER=virtualbox
VAGRANT_BOX=bento/ubuntu-24.04
# Vide = dernière version de la box disponible pour le provider choisi.
VAGRANT_BOX_VERSION=
# Réseau privé des VMs : 192.168.56.10 = control-plane, .11, .12... = workers.
VAGRANT_NETWORK_PREFIX=192.168.56
VAGRANT_IP_START=10

# -----------------------------------------------------------------------------
#  Versions d'outils recommandées (utilisées par "doctor" et par la CI)
# -----------------------------------------------------------------------------
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.37.1
MINIKUBE_VERSION=v1.39.0
TERRAFORM_VERSION=1.16.4
TFLINT_VERSION=v0.64.0
VAGRANT_VERSION=2.4.9
