# =============================================================================
#  k8s-lab — configuration par défaut (versionnée dans Git)
# =============================================================================
#
#  C'est LE fichier central du lab : tous les modes (kind, minikube, vagrant,
#  terraform, existing, attach) lisent leurs réglages ici, via ./k8s-lab.
#
#  Ne modifiez pas ce fichier pour vos essais personnels : copiez plutôt
#  .env.example en .env (ignoré par Git) et surchargez-y les valeurs voulues.
#  Des .env complets prêts à adapter : examples/profiles/
#
#  Ordre de priorité (le premier trouvé gagne) :
#    1. variable d'environnement      ex : WORKER_COUNT=3 ./k8s-lab deploy kind
#    2. argument make                 ex : make deploy MODE=kind WORKERS=3
#    3. fichier .env                  (vos réglages / secrets, non versionné)
#    4. ce fichier config/lab.env     (valeurs par défaut)
#
#  Format : une ligne CLE=valeur, sans espace autour du "=".
#  Les commentaires doivent être sur leur propre ligne.
#  Une valeur vide signifie « non défini / automatique ».
#
#  Chaque variable est décrite (type, valeurs possibles) dans
#  config/schema.yaml et validée AVANT toute action : ./k8s-lab config
#  Référence complète : docs/configuration.md
#  Versions des composants : config/versions.yaml (fichier de verrouillage)
# =============================================================================

# -----------------------------------------------------------------------------
#  Plateforme de déploiement
# -----------------------------------------------------------------------------
# Mode utilisé quand la commande n'en précise pas (make deploy sans MODE=).
# kind | minikube | vagrant | terraform | existing | attach   (vide = à préciser)
DEPLOYMENT_MODE=
# Provider Terraform quand DEPLOYMENT_MODE=terraform : proxmox | vsphere | libvirt | eks
DEPLOYMENT_PROVIDER=

# -----------------------------------------------------------------------------
#  Forme du cluster
# -----------------------------------------------------------------------------
# Nom du cluster : sert au nom du contexte kubectl et au préfixe des ressources.
CLUSTER_NAME=k8s-lab
# Nombre de control-planes : 1 (standard) ou 3 / 5 (haute disponibilité, etcd
# empilé). Les nombres pairs sont refusés (aucun gain de tolérance pour etcd).
CONTROL_PLANE_COUNT=1
# Nombre de workers (0 = cluster mono-nœud : le control-plane accepte les Pods).
WORKER_COUNT=2
# auto (1 CP = off, 3 ou 5 CP = stacked-etcd) | off | stacked-etcd
# (external-etcd : évolution prévue, refusée pour l'instant, voir docs/high-availability.md)
HA_MODE=auto
# Adresse stable de l'API (host:port). auto = VIP si CONTROL_PLANE_VIP, sinon IP du 1er control-plane.
CONTROL_PLANE_ENDPOINT=auto
# VIP de l'API Kubernetes (obligatoire en HA avec kube-vip ; conseillée même
# avec 1 control-plane si vous comptez passer en HA plus tard).
CONTROL_PLANE_VIP=
# Répartiteur de l'API : auto | kube-vip | external (votre HAProxy/LB) | none
API_LB_PROVIDER=auto

# -----------------------------------------------------------------------------
#  Machines (vagrant, terraform ; ignoré par kind, minikube, eks, attach)
# -----------------------------------------------------------------------------
# Préfixe des hostnames : k8s-cp-1, k8s-worker-1, k8s-worker-2, ...
NODE_HOSTNAME_PREFIX=k8s
# kubeadm exige au moins 2 vCPU et ~1,7 Go de RAM sur le control-plane.
NODE_CPUS=2
NODE_MEMORY_MB=2048
NODE_DISK_GB=20
# Type de CPU virtuel (Proxmox). x86-64-v2-AES fonctionne sur les CPU anciens
# (Westmere, Xeon X5690) ; Rocky Linux 10 exige x86-64-v3 (AVX2).
NODE_CPU_TYPE=x86-64-v2-AES
# Clé SSH utilisée par Ansible. Vide = une clé dédiée au lab est générée
# automatiquement dans .lab/ssh/ (recommandé : on ne réutilise pas votre clé perso).
SSH_PRIVATE_KEY_FILE=
# Utilisateur SSH créé par cloud-init. Vide = celui de la distribution (ubuntu, debian, rocky).
NODE_SSH_USER=

# -----------------------------------------------------------------------------
#  Système d'exploitation des nœuds (modes vagrant, terraform, existing)
# -----------------------------------------------------------------------------
# ubuntu | debian | rocky | auto (auto : détecté sur chaque machine, mode existing)
NODE_OS=ubuntu
# Version parmi la matrice supportée (config/versions.yaml) :
# ubuntu 24.04 / 26.04, debian 12 / 13, rocky 9 / 10
NODE_OS_VERSION=24.04
# catalog (image épinglée de config/versions.yaml) | url (NODE_IMAGE_URL) | template
NODE_IMAGE_SOURCE=catalog
# Image personnalisée (NODE_IMAGE_SOURCE=url) + son SHA-256 (obligatoire).
NODE_IMAGE_URL=
NODE_IMAGE_SHA256=
# Template existant (NODE_IMAGE_SOURCE=template) : ID Proxmox ou nom de template vSphere.
NODE_TEMPLATE_ID=
# Anciennes variables (toujours acceptées) : si définies, équivalent à
# NODE_IMAGE_SOURCE=url avec NODE_IMAGE_URL/NODE_IMAGE_SHA256 (qui restent prioritaires).
VM_IMAGE_URL=
VM_IMAGE_SHA256=
# Swap des nœuds : disable (défaut kubeadm) | keep (kubelet LimitedSwap, usage avancé)
NODE_SWAP=disable
# Pare-feu des nœuds : auto (firewalld géré sur Rocky, ufw/nftables laissés tels
# quels sur Ubuntu/Debian) | managed | unmanaged (vous ouvrez les ports vous-même)
NODE_FIREWALL=auto

# -----------------------------------------------------------------------------
#  Kubernetes installé par kubeadm (modes vagrant, terraform, existing)
# -----------------------------------------------------------------------------
# Version complète. 1.36.5 = la plus récente compatible avec tout le catalogue
# (1.37.x est possible : docs/versions.md). Le dépôt pkgs.k8s.io est déduit (v1.36).
KUBERNETES_VERSION=1.36.5
# Réseau des Pods et réseau des Services : ne doivent chevaucher ni les
# réseaux des nœuds ni RESERVED_CIDRS.
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
# Réseaux déjà utilisés sur votre LAN (VLAN, VPN...), séparés par des virgules :
# Pods et Services ne doivent pas les chevaucher. Ex : 10.10.0.0/16,10.30.0.0/16
RESERVED_CIDRS=
# Réseau des nœuds (pour les contrôles de chevauchement). Vide = déduit de
# terraform.tfvars (network_cidr), de Vagrant ou de l'inventaire (mode existing).
NODE_NETWORK_CIDR=
# Adresses du réseau des nœuds à ne jamais attribuer (passerelle, hyperviseur,
# plage DHCP...), ex : 10.20.0.1,10.20.0.31,10.20.0.50-10.20.0.99
RESERVED_IPS=
# Runtime de conteneurs : seul containerd est supporté (paquet containerd.io).
CONTAINER_RUNTIME=containerd
# Motif de version du paquet containerd.io (2.x requis). Vide = config/versions.yaml.
CONTAINERD_VERSION=
# Étiquetage SELinux des conteneurs par containerd (Rocky). false = SELinux reste
# en mode enforcing sur l'hôte, sans confinement SELinux des conteneurs (docs/security.md).
CONTAINERD_SELINUX=false
# Certificats de service des kubelets : signed (signés par la CA du cluster,
# approuvés automatiquement ; requis pour metrics-server sans --kubelet-insecure-tls)
# | self-signed (comportement historique de kubeadm)
KUBELET_SERVING_CERTS=signed

# -----------------------------------------------------------------------------
#  Réseau des Pods (CNI)
# -----------------------------------------------------------------------------
# auto | flannel | calico | cilium | none
# auto = flannel (kubeadm), kindnet (kind), CNI natif (minikube), aws-vpc-cni (EKS)
CNI=auto
# Version du CNI. Vide = version verrouillée (config/versions.yaml).
CNI_VERSION=
# Mode réseau du CNI. auto = défaut du CNI.
#   flannel : vxlan | host-gw          calico : vxlan | vxlan-crosssubnet | ipip | ipip-crosssubnet | direct
#   cilium  : vxlan | geneve | native
CNI_MODE=auto
# Mode de kube-proxy : auto | iptables | nftables | ipvs | cilium
# auto = cilium (remplacement eBPF de kube-proxy) avec CNI=cilium, iptables sinon.
KUBE_PROXY_MODE=auto
# NetworkPolicy : auto | none | kubernetes | calico | cilium
# (Flannel seul n'applique AUCUNE NetworkPolicy : seules auto/none sont acceptées.)
NETWORK_POLICY_MODE=auto
# Hubble (observabilité réseau de Cilium, CNI=cilium uniquement).
ENABLE_HUBBLE=false
HUBBLE_UI=false
# Ancienne variable (version de Flannel) : équivalent à CNI_VERSION avec CNI=flannel.
FLANNEL_VERSION=

# -----------------------------------------------------------------------------
#  Gateway API (publication des applications par nom DNS)
# -----------------------------------------------------------------------------
# auto (choisi par ADDON_PROFILE) | none | traefik | envoy-gateway | cilium
GATEWAY_CONTROLLER=auto
# Version des CRD Gateway API. Vide = celle exigée par le contrôleur choisi.
GATEWAY_API_VERSION=
# standard | experimental (TCPRoute, UDPRoute... selon le contrôleur)
GATEWAY_API_CHANNEL=standard
# Domaine des applications publiées : <app>.<GATEWAY_DOMAIN>
GATEWAY_DOMAIN=k8s-lab.internal
# Écouteur HTTPS : auto (si cert-manager est installé) | true | false
GATEWAY_TLS=auto
# Service du Gateway : auto (LoadBalancer si un LoadBalancer est disponible, sinon NodePort)
GATEWAY_SERVICE_TYPE=auto

# -----------------------------------------------------------------------------
#  Services de type LoadBalancer (bare metal)
# -----------------------------------------------------------------------------
# auto (choisi par ADDON_PROFILE) | none | metallb | cilium-l2 | cilium-bgp
LOADBALANCER_PROVIDER=auto
# MetalLB : l2 | bgp
LOADBALANCER_MODE=l2
# Plage(s) d'IP attribuées aux Services, ex : 10.20.0.200-10.20.0.210 (À VALIDER
# dans votre IPAM : hors DHCP, hors IP fixes, dans le réseau des nœuds en L2).
LOADBALANCER_IP_POOL=
# Interfaces réseau annonçant les IP en L2 (expression régulière, vide = toutes).
LOADBALANCER_INTERFACES=
# BGP (cilium-bgp ou MetalLB bgp) : activation explicite, jamais supposée.
BGP_LOCAL_ASN=
BGP_PEER_ADDRESS=
BGP_PEER_ASN=

# -----------------------------------------------------------------------------
#  Stockage persistant
# -----------------------------------------------------------------------------
# Backends installés : nfs-csi, longhorn (liste, vide = aucun).
STORAGE_BACKENDS=
# StorageClass par défaut : auto | nfs-csi | longhorn | platform | none
# auto = le seul backend choisi ; platform = garder celle de kind/minikube/EKS.
DEFAULT_STORAGE_CLASS=auto

# --- NFS CSI (nfs.csi.k8s.io) ---
# Serveur et export NFS (l'export doit EXISTER et être autorisé pour les nœuds).
NFS_SERVER=
NFS_SHARE=
NFS_VERSION=4.1
NFS_STORAGE_CLASS=nfs-csi
# Retain (défaut, protecteur) | Delete
NFS_RECLAIM_POLICY=Retain
# Options de montage supplémentaires (séparées par des virgules), ex : hard,noatime
NFS_MOUNT_OPTIONS=hard
# Sous-dossier créé par volume (modèle csi-driver-nfs).
NFS_SUBDIR=${pvc.metadata.namespace}-${pvc.metadata.name}-${pv.metadata.name}
# Ancienne forme : true = DEFAULT_STORAGE_CLASS=nfs-csi
NFS_DEFAULT_STORAGE_CLASS=

# --- Longhorn (stockage distribué sur les disques des workers) ---
# auto-compatible = version verrouillée de config/versions.yaml (jamais "latest").
LONGHORN_VERSION=auto-compatible
LONGHORN_REPLICA_COUNT=3
LONGHORN_DATA_PATH=/var/lib/longhorn
LONGHORN_STORAGE_CLASS=longhorn
# Retain (défaut, protecteur : le volume survit à la suppression du PVC) | Delete
LONGHORN_RECLAIM_POLICY=Retain
# Interface web (Service ClusterIP ; exposée par la Gateway seulement si LONGHORN_UI_EXPOSE=true).
LONGHORN_UI_ENABLED=true
LONGHORN_UI_EXPOSE=false
# Sauvegardes des volumes vers une cible externe (nfs://hote:/export ou s3://bucket@region/).
LONGHORN_BACKUP_ENABLED=false
LONGHORN_BACKUP_TARGET=
# Disque virtuel dédié sur chaque worker (terraform, vagrant), monté sur LONGHORN_DATA_PATH.
LONGHORN_DEDICATED_DISK=false
LONGHORN_DISK_SIZE_GB=100
# Stockage du disque dédié (vide = celui des VMs).
LONGHORN_DISK_DATASTORE=
# Mode existing : périphérique à utiliser (ex : /dev/disk/by-id/...). Jamais deviné.
LONGHORN_DISK_DEVICE=
# Autorise le formatage d'un disque VIDE (aucune partition, aucune signature).
# Un disque contenant des données n'est JAMAIS formaté.
LONGHORN_DISK_ALLOW_FORMAT=false

# -----------------------------------------------------------------------------
#  Addons
# -----------------------------------------------------------------------------
# minimal | homelab | observability | enterprise-lab | ci | custom   (docs/addons.md)
ADDON_PROFILE=minimal
# Liste d'addons (virgules). Avec un profil : ajouts (nom) ou retraits (-nom).
# Avec ADDON_PROFILE=custom : la liste complète.  Catalogue : make addons-catalog
ADDONS=
# Politique de compatibilité : warn (avertir pour une combinaison non testée en
# amont) | strict (la refuser). Les combinaisons non supportées sont TOUJOURS refusées.
COMPATIBILITY_POLICY=warn
# Mode attach : que faire d'un composant déjà installé par un autre outil ?
# fail (refuser, défaut) | skip (l'utiliser tel quel, sans le gérer)
EXISTING_ADDON_POLICY=fail

# --- cert-manager ---
# selfsigned-ca (CA interne, aucun domaine public requis) | acme-http01 | acme-dns01 | none
CERT_MANAGER_ISSUER=selfsigned-ca
ACME_EMAIL=
# staging (défaut, pour tester) | production
ACME_ENVIRONMENT=staging
# Fournisseur DNS-01 : cloudflare | rfc2136 (BIND, Windows DNS...) | route53
ACME_DNS01_PROVIDER=
# rfc2136 : serveur DNS et nom de la clé TSIG (le secret va dans .env : RFC2136_TSIG_SECRET)
RFC2136_NAMESERVER=
RFC2136_TSIG_KEY_NAME=
RFC2136_TSIG_ALGORITHM=HMACSHA256

# --- Argo CD ---
# Dépôt Git à synchroniser (vide = Argo CD seul, sans application d'exemple).
ARGOCD_REPO_URL=
ARGOCD_REPO_PATH=examples/gitops/apps
ARGOCD_REPO_REVISION=HEAD
# Synchronisation automatique de l'application d'exemple (false = manuelle, contrôlée).
ARGOCD_AUTO_SYNC=false
ARGOCD_EXPOSE=false

# --- Supervision (kube-prometheus-stack) ---
MONITORING_RETENTION=7d
# Persistance de Prometheus/Grafana/Alertmanager (nécessite une StorageClass).
MONITORING_PERSISTENCE=false
MONITORING_STORAGE_SIZE_GB=10
GRAFANA_EXPOSE=false

# --- Journaux (Loki + Alloy) ---
LOGGING_RETENTION=168h
LOGGING_PERSISTENCE=false
# Collecte aussi le journal systemd des nœuds (montage hostPath, Pods privilégiés).
LOGGING_NODE_LOGS=false

# --- Sécurité ---
# Kyverno : audit (rapports seulement) | enforce (bloque) | none (pas de politique d'exemple)
KYVERNO_POLICY_MODE=audit

# --- Sauvegarde et reprise ---
BACKUP_ENABLED=false
# etcd-snapshot (kubeadm) | velero | both
BACKUP_PROVIDER=etcd-snapshot
# Planification (format cron) des sauvegardes automatiques.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=7
# Velero : stockage S3-compatible (MinIO, Synology C2/S3, Garage...). Clés : .env
VELERO_S3_URL=
VELERO_BUCKET=
VELERO_REGION=minio
# Sauvegarde des volumes par copie de fichiers (node-agent / Kopia).
VELERO_FS_BACKUP=true

# --- DNS automatisé (ExternalDNS) ---
# rfc2136 | cloudflare | pihole  (AdGuard Home et Stormshield ne sont pas supportés)
EXTERNAL_DNS_PROVIDER=
EXTERNAL_DNS_DOMAIN_FILTER=
PIHOLE_SERVER=

# -----------------------------------------------------------------------------
#  Exploitation
# -----------------------------------------------------------------------------
# Mises à jour proposées par make versions-check : patch | minor (jamais automatiques)
UPGRADE_POLICY=patch
# Vérifications de santé à la fin du déploiement.
ENABLE_HEALTHCHECKS=true
# Tests fonctionnels (application, DNS, addons) à la fin du déploiement.
ENABLE_POST_DEPLOY_TESTS=true

# -----------------------------------------------------------------------------
#  Mode existing (machines Linux déjà installées : aucune VM créée)
# -----------------------------------------------------------------------------
# Inventaire Ansible (INI ou YAML) de vos machines, ex : ansible/inventories/homelab.ini
EXISTING_INVENTORY=

# -----------------------------------------------------------------------------
#  Mode attach (cluster Kubernetes déjà installé : addons uniquement)
# -----------------------------------------------------------------------------
EXISTING_KUBECONFIG=
EXISTING_CONTEXT=

# -----------------------------------------------------------------------------
#  Kind (Kubernetes dans des conteneurs Docker)
# -----------------------------------------------------------------------------
# Vide = image épinglée de config/versions.yaml pour la mineure de KUBERNETES_VERSION.
KIND_NODE_IMAGE=
# Chemin d'une config kind personnalisée (vide = générée depuis ces réglages,
# voir local/kind/kind-config.yaml).
KIND_CONFIG=

# -----------------------------------------------------------------------------
#  Minikube
# -----------------------------------------------------------------------------
# Vide = v + KUBERNETES_VERSION.
MINIKUBE_KUBERNETES_VERSION=
# Driver : vide = détection automatique (docker, podman, kvm2, virtualbox...).
MINIKUBE_DRIVER=
# Minikube est utilisé en mono-nœud par défaut (usage "découverte" + addons).
MINIKUBE_NODES=1
MINIKUBE_CPUS=2
MINIKUBE_MEMORY_MB=2048
# Options supplémentaires passées à "minikube start" (ex : --addons=ingress).
MINIKUBE_EXTRA_ARGS=

# -----------------------------------------------------------------------------
#  Vagrant
# -----------------------------------------------------------------------------
# virtualbox (défaut) | libvirt | vmware_desktop | vmware_esxi (historique)
VAGRANT_PROVIDER=virtualbox
# Vide = box de la distribution choisie (NODE_OS / NODE_OS_VERSION, config/versions.yaml).
VAGRANT_BOX=
# Vide = dernière version de la box disponible pour le provider choisi.
VAGRANT_BOX_VERSION=
# Réseau privé des VMs : .10, .11... = control-planes, puis les workers.
VAGRANT_NETWORK_PREFIX=192.168.56
VAGRANT_IP_START=10

# -----------------------------------------------------------------------------
#  AWS EKS (Kubernetes managé : make deploy MODE=terraform PROVIDER=eks)
# -----------------------------------------------------------------------------
# Version de Kubernetes du cluster EKS. EKS a son propre calendrier de versions :
# elle peut différer de KUBERNETES_VERSION (kubeadm). Versions proposées par EKS :
# https://docs.aws.amazon.com/eks/latest/userguide/kubernetes-versions.html
EKS_KUBERNETES_VERSION=1.36
# Cible : aws (vrai AWS, ressources payantes) ou localstack (émulateur local ;
# EKS y exige une licence LocalStack Ultimate, Student ou open source).
AWS_TARGET=aws
# Adresse de LocalStack (utilisée seulement avec AWS_TARGET=localstack).
LOCALSTACK_ENDPOINT=http://localhost:4566
# Région, type d'instance... : terraform/providers/eks/terraform.tfvars.
# Identifiants : aws configure / AWS_PROFILE (jamais dans ce dépôt).

# -----------------------------------------------------------------------------
#  Versions d'outils recommandées (utilisées par "doctor" et par la CI)
# -----------------------------------------------------------------------------
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.37.1
MINIKUBE_VERSION=v1.39.0
HELM_VERSION=v4.3.0
TERRAFORM_VERSION=1.16.5
TFLINT_VERSION=v0.64.0
VAGRANT_VERSION=2.4.9
ACTIONLINT_VERSION=1.7.12
