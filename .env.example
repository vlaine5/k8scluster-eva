# =============================================================================
#  k8s-lab — vos réglages personnels et vos secrets
# =============================================================================
#
#    cp .env.example .env
#
#  .env est ignoré par Git : c'est ici (et seulement ici) que vont les
#  identifiants Proxmox / vSphere / ESXi. Ne les mettez JAMAIS dans un
#  fichier versionné (tfvars, Vagrantfile, playbook...).
#
#  Toute clé de config/lab.env peut être surchargée ici.
#  Format : CLE=valeur (sans espace autour du "="), une par ligne.
# =============================================================================

# --- Exemples de surcharge ---------------------------------------------------
# WORKER_COUNT=3
# NODE_MEMORY_MB=4096
# VAGRANT_PROVIDER=libvirt
# MINIKUBE_DRIVER=docker

# --- Proxmox VE (lu directement par le provider Terraform bpg/proxmox) -------
# Créez un token API dédié : voir docs/terraform-proxmox.md
# PROXMOX_VE_ENDPOINT=https://pve.example.lan:8006/
# PROXMOX_VE_API_TOKEN=terraform@pve!k8s-lab=00000000-0000-0000-0000-000000000000
# Uniquement si votre Proxmox utilise un certificat auto-signé :
# PROXMOX_VE_INSECURE=true

# --- VMware vCenter (lu directement par le provider Terraform vmware/vsphere) -
# Jamais de mot de passe dans terraform.tfvars : uniquement ici.
# VSPHERE_SERVER=vcenter.example.lan
# VSPHERE_USER=terraform@vsphere.local
# VSPHERE_PASSWORD=change-me
# Uniquement si votre vCenter utilise un certificat auto-signé :
# VSPHERE_ALLOW_UNVERIFIED_SSL=true

# --- libvirt/KVM (Terraform) --------------------------------------------------
# LIBVIRT_DEFAULT_URI=qemu:///system

# --- ESXi standalone (Vagrant + plugin vagrant-vmware-esxi, mode historique) --
# ESXI_HOSTNAME=esxi.example.lan
# ESXI_USERNAME=root
# ESXI_PASSWORD=change-me
# ESXI_DATASTORE=datastore1
# Réseau "public" (NAT/DHCP) puis réseau portant les IP statiques du cluster :
# ESXI_NETWORKS=VM Network,K8S Network
