# =============================================================================
#  k8s-lab — vos réglages personnels et vos secrets
# =============================================================================
#
#    cp .env.example .env                 (ou un profil : examples/profiles/*.env)
#
#  .env est ignoré par Git : c'est ici, et SEULEMENT ici, que vont les secrets
#  (identifiants d'hyperviseur, mots de passe, jetons, clés S3). Jamais dans un
#  fichier versionné (tfvars, Vagrantfile, playbook, valeurs Helm...). Le CLI ne
#  les affiche jamais (make config les masque) et ne les écrit dans aucun fichier
#  de variables Ansible ni manifeste.
#
#  Toute clé de config/lab.env peut être surchargée ici (référence complète :
#  docs/configuration.md). Format : CLE=valeur, sans espace autour du « = ».
#  Vérification sans rien modifier : make config / make validate.
# =============================================================================

# --- Exemples de réglages ------------------------------------------------------
# DEPLOYMENT_MODE=kind                  # kind | minikube | vagrant | terraform | existing | attach
# DEPLOYMENT_PROVIDER=proxmox           # avec terraform : proxmox | vsphere | libvirt | eks
# CLUSTER_NAME=k8s-lab
# CONTROL_PLANE_COUNT=1                 # 1, 3 ou 5 (3 et 5 : CONTROL_PLANE_VIP obligatoire)
# WORKER_COUNT=2
# NODE_OS=ubuntu                        # ubuntu | debian | rocky
# NODE_OS_VERSION=24.04
# CNI=auto                              # flannel | calico | cilium | none
# ADDON_PROFILE=minimal                 # minimal | homelab | observability | enterprise-lab | custom
# ADDONS=cert-manager,metrics-server    # ajouts (nom) ou retraits (-nom) au profil

# --- Proxmox VE (lu directement par le provider Terraform bpg/proxmox) -------
# Token API dédié, droits limités : docs/deploy-proxmox.md
# PROXMOX_VE_ENDPOINT=https://pve.example.lan:8006/
# PROXMOX_VE_API_TOKEN=terraform@pve!k8s-lab=00000000-0000-0000-0000-000000000000
# Uniquement si votre Proxmox utilise un certificat auto-signé :
# PROXMOX_VE_INSECURE=true

# --- VMware vCenter (lu directement par le provider Terraform vmware/vsphere) -
# VSPHERE_SERVER=vcenter.example.lan
# VSPHERE_USER=terraform@vsphere.local
# VSPHERE_PASSWORD=change-me
# VSPHERE_ALLOW_UNVERIFIED_SSL=true    # uniquement avec un certificat auto-signé

# --- AWS EKS (Terraform, provider hashicorp/aws) ------------------------------
# De préférence un profil d'AWS CLI (aws configure / aws configure sso) : jamais
# de clé d'accès dans un fichier du dépôt.
# AWS_PROFILE=default
# AWS_REGION=eu-west-3
# AWS_TARGET=localstack                 # émulateur local au lieu du vrai AWS

# --- libvirt/KVM (Terraform) --------------------------------------------------
# LIBVIRT_DEFAULT_URI=qemu:///system

# --- ESXi autonome (Vagrant + plugin vagrant-vmware-esxi, mode historique) ----
# ESXI_HOSTNAME=esxi.example.lan
# ESXI_USERNAME=root
# ESXI_PASSWORD=change-me
# ESXI_DATASTORE=datastore1
# ESXI_NETWORKS=VM Network,K8S Network

# --- Secrets des addons (créés en Secrets Kubernetes, jamais dans les valeurs) -
# Grafana (addon monitoring) : vide = mot de passe aléatoire généré par le chart.
# GRAFANA_ADMIN_PASSWORD=
# Argo CD : dépôt Git privé (jeton en LECTURE SEULE).
# ARGOCD_REPO_USERNAME=
# ARGOCD_REPO_PASSWORD=
# cert-manager (ACME DNS-01) et ExternalDNS.
# CLOUDFLARE_API_TOKEN=
# RFC2136_TSIG_SECRET=
# PIHOLE_PASSWORD=
# Velero : stockage S3-compatible (clé d'accès dédiée, limitée au bucket).
# VELERO_S3_ACCESS_KEY=
# VELERO_S3_SECRET_KEY=
# Longhorn : sauvegardes des volumes vers S3.
# LONGHORN_BACKUP_S3_ENDPOINT=
# LONGHORN_BACKUP_S3_ACCESS_KEY=
# LONGHORN_BACKUP_S3_SECRET_KEY=
