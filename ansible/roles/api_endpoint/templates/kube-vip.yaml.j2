# {{ ansible_managed }}
# kube-vip {{ lab_lock.kube_vip.version }} : VIP {{ control_plane_vip }} de l'API Kubernetes (ARP, plan de contrôle uniquement).
# Le leader (un seul control-plane à la fois) répond aux requêtes ARP pour la VIP.
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
  labels:
    app.kubernetes.io/name: kube-vip
    app.kubernetes.io/part-of: k8s-lab
spec:
  containers:
    - name: kube-vip
      image: "{{ lab_lock.kube_vip.image }}:{{ lab_lock.kube_vip.version }}"
      imagePullPolicy: IfNotPresent
      args: [manager]
      env:
        - {name: vip_arp, value: "true"}
        - {name: port, value: "{{ k8s_api_port }}"}
        - {name: vip_nodename, valueFrom: {fieldRef: {fieldPath: spec.nodeName}}}
        - {name: vip_interface, value: "{{ api_endpoint_interface }}"}
        - {name: vip_subnet, value: "32"}
        - {name: dns_mode, value: first}
        - {name: cp_enable, value: "true"}
        - {name: cp_namespace, value: kube-system}
        - {name: svc_enable, value: "false"}
        - {name: vip_leaderelection, value: "true"}
        - {name: vip_leasename, value: plndr-cp-lock}
        - {name: vip_leaseduration, value: "5"}
        - {name: vip_renewdeadline, value: "3"}
        - {name: vip_retryperiod, value: "1"}
        - {name: address, value: "{{ control_plane_vip }}"}
        - {name: prometheus_server, value: ":2112"}
      securityContext:
        capabilities:
          add: [NET_ADMIN, NET_RAW]
          drop: [ALL]
      resources:
        requests: {cpu: 20m, memory: 32Mi}
      volumeMounts:
        - name: kubeconfig
          mountPath: /etc/kubernetes/admin.conf
          readOnly: true
  hostAliases:
    - hostnames: [kubernetes]
      ip: 127.0.0.1
  hostNetwork: true
  priorityClassName: system-node-critical
  volumes:
    - name: kubeconfig
      hostPath:
        path: "{{ api_endpoint_kubeconfig }}"
        type: File
