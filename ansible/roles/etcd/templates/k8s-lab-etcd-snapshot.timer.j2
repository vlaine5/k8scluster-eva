# {{ ansible_managed }}
# Planification issue de BACKUP_SCHEDULE ({{ backup.schedule | default('0 3 * * *') }}).
[Unit]
Description=k8s-lab : instantanés etcd planifiés

[Timer]
OnCalendar={{ backup.on_calendar | default('*-*-* 03:00:00') }}
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
