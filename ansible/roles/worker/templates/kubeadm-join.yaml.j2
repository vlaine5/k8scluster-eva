# {{ ansible_managed }}
# Configuration de "kubeadm join" (supprimée juste après : elle contient un jeton).
# Référence : https://kubernetes.io/docs/reference/config-api/kubeadm-config.v1beta4/
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ k8s_api_endpoint }}"
    token: "{{ worker_join_token }}"
    # Empreinte de la CA du cluster : le worker vérifie qu'il parle au BON API server.
    caCertHashes:
      - "{{ worker_join_ca_hash }}"
nodeRegistration:
  name: "{{ inventory_hostname }}"
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ k8s_node_ip }}"
{% if worker_ignore_preflight_errors | length > 0 %}
  ignorePreflightErrors: {{ worker_ignore_preflight_errors | to_json }}
{% endif %}
