# {{ ansible_managed }}
# Configuration de "kubeadm join --control-plane" (supprimée juste après : elle
# contient un jeton et la clé de déchiffrement des certificats).
# Référence : https://kubernetes.io/docs/reference/config-api/kubeadm-config.v1beta4/
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ k8s_api_endpoint }}"
    token: "{{ control_plane_join_token }}"
    caCertHashes:
      - "{{ control_plane_join_ca_hash }}"
controlPlane:
  localAPIEndpoint:
    advertiseAddress: "{{ k8s_node_ip }}"
    bindPort: 6443
  certificateKey: "{{ control_plane_certificate_key }}"
nodeRegistration:
  name: "{{ inventory_hostname }}"
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ k8s_node_ip }}"
{% if control_plane_ignore_preflight_errors | length > 0 %}
  ignorePreflightErrors: {{ control_plane_ignore_preflight_errors | to_json }}
{% endif %}
