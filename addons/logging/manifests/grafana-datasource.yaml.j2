{% if 'monitoring' in lab_addon_ids %}
# Source de données Loki chargée par Grafana (sidecar, étiquette grafana_datasource).
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasource-loki
  namespace: logging
  labels:
    app.kubernetes.io/managed-by: k8s-lab
    grafana_datasource: "1"
data:
  loki.yaml: |
    apiVersion: 1
    datasources:
      - name: Loki
        uid: loki
        type: loki
        access: proxy
        url: http://loki.logging.svc:3100
{% if 'tempo' in lab_addon_ids %}
        jsonData:
          derivedFields:
            - name: TraceID
              matcherRegex: '"?trace_?[iI][dD]"?[:=]"?(\w+)'
              url: '$${__value.raw}'
              datasourceUid: tempo
{% endif %}
{% endif %}
