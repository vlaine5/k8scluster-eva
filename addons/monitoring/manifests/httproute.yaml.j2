{% if cfg.GRAFANA_EXPOSE | bool %}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: grafana
  namespace: monitoring
  labels: {app.kubernetes.io/managed-by: k8s-lab}
spec:
  parentRefs:
    - name: lab-gateway
      namespace: gateway-system
      sectionName: {{ 'https' if lab.gateway_tls else 'http' }}
  hostnames: ["grafana.{{ cfg.GATEWAY_DOMAIN }}"]
  rules:
    - backendRefs:
        - name: kube-prometheus-stack-grafana
          port: 80
{% endif %}
