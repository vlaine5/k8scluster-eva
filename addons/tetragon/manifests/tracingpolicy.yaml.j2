# Politique d'observation (aucune action bloquante) : lectures des fichiers sensibles.
apiVersion: cilium.io/v1alpha1
kind: TracingPolicy
metadata:
  name: k8s-lab-sensitive-files
  labels: {app.kubernetes.io/managed-by: k8s-lab}
spec:
  kprobes:
    - call: security_file_permission
      syscall: false
      return: true
      args:
        - {index: 0, type: file}
        - {index: 1, type: int}
      returnArg: {index: 0, type: int}
      returnArgAction: Post
      selectors:
        - matchArgs:
            - index: 0
              operator: Prefix
              values: [/etc/shadow, /etc/sudoers, /root/.ssh]
            - index: 1
              operator: Equal
              values: ["4"]
