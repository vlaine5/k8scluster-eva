# Plage d'IP attribuée aux Services LoadBalancer (LOADBALANCER_IP_POOL, validée par ./k8s-lab).
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: lab-pool
  namespace: metallb-system
spec:
  addresses: {{ lab.loadbalancer.pool | to_json }}
  autoAssign: true
---
{% if lab.loadbalancer.mode == 'bgp' %}
# BGP : session vers le routeur pair (configuré et validé de SON côté au préalable).
apiVersion: metallb.io/v1beta2
kind: BGPPeer
metadata:
  name: lab-router
  namespace: metallb-system
spec:
  myASN: {{ cfg.BGP_LOCAL_ASN }}
  peerASN: {{ cfg.BGP_PEER_ASN }}
  peerAddress: "{{ cfg.BGP_PEER_ADDRESS }}"
---
apiVersion: metallb.io/v1beta1
kind: BGPAdvertisement
metadata:
  name: lab-bgp
  namespace: metallb-system
spec:
  ipAddressPools: [lab-pool]
{% else %}
# L2 : le speaker élu répond aux requêtes ARP pour chaque IP attribuée.
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: lab-l2
  namespace: metallb-system
spec:
  ipAddressPools: [lab-pool]
{% if lab.loadbalancer.interfaces %}
  interfaces: {{ lab.loadbalancer.interfaces.split(',') | map('trim') | list | to_json }}
{% endif %}
{% endif %}
