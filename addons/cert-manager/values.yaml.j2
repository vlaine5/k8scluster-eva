# Valeurs du chart cert-manager (version verrouillée dans config/versions.yaml).
crds:
  enabled: true
  # Désinstaller cert-manager ne supprime jamais les CRD (donc jamais les certificats).
  keep: true
replicaCount: 1
{% if 'gateway-api-crds' in lab_addon_ids %}
# Certificats demandés par annotation sur les Gateway + solveur HTTP-01 par HTTPRoute.
config:
  apiVersion: controller.config.cert-manager.io/v1alpha1
  kind: ControllerConfiguration
  enableGatewayAPI: true
{% endif %}
prometheus:
  enabled: true
  servicemonitor:
    enabled: {{ 'prometheus-operator-crds' in lab_addon_ids }}
resources:
  requests: {cpu: 20m, memory: 64Mi}
webhook:
  resources:
    requests: {cpu: 10m, memory: 32Mi}
cainjector:
  resources:
    requests: {cpu: 10m, memory: 64Mi}
